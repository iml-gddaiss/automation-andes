<VirtualHost *:80>

    # handle annoying apple icon requests
    Redirect 404 /apple-touch-icon.png
    Redirect 404 /apple-touch-icon-precomposed.png
    Redirect 404 /apple-touch-icon-120x120.png
    Redirect 404 /apple-touch-icon-120x120-precomposed.png
    
    ErrorLog ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined

    Alias /static {{ andes_dir }}/staticfiles
    <Directory {{ andes_dir }}/staticfiles>
        Require all granted
    </Directory>

    Alias /media {{ andes_dir }}/media
    <Directory {{ andes_dir }}/media>
        Require all granted
        Header set Access-Control-Allow-Origin "*"

    </Directory>

    <Directory {{ andes_dir }}/andes>
        <Files wsgi.py>
            Require all granted
        </Files>
    </Directory>

    WSGIDaemonProcess andes python-home={{ virtualenv_dir }} python-path={{ andes_dir }} 
    WSGIProcessGroup andes
    WSGIScriptAlias / {{ andes_dir }}/andes/wsgi.py
    WSGIApplicationGroup %{GLOBAL}
    TimeOut 25000
</VirtualHost>
